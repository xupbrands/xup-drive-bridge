# Copy this file's contents into Railway's "Variables" tab for this service.
# Do not commit a real .env file with actual secrets to git.

# From Google Cloud Console > APIs & Services > Credentials > OAuth 2.0 Client ID
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# This service's own public URL once deployed (Railway assigns one, or use a
# custom domain). Must exactly match a redirect URI registered in Google Cloud
# Console under this OAuth Client ID, with /auth/callback appended there.
# Example: https://xup-drive-bridge-production.up.railway.app
PUBLIC_URL=
